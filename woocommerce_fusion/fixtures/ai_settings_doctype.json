[
  {
    "doctype": "DocType",
    "name": "AI Settings",
    "module": "WooCommerce Fusion",
    "custom": 1,
    "istable": 0,
    "issingle": 1,
    "is_submittable": 0,
    "track_changes": 1,
    "allow_rename": 0,
    "read_only": 0,
    "permissions": [
      {
        "role": "System Manager",
        "read": 1,
        "write": 1,
        "create": 1,
        "delete": 1,
        "report": 1,
        "export": 1,
        "print": 1,
        "email": 1,
        "share": 1
      }
    ],
    "fields": [
      {
        "fieldname": "openai_section",
        "label": "OpenAI",
        "fieldtype": "Section Break"
      },
      {
        "fieldname": "openai_api_key",
        "label": "OpenAI API Key",
        "fieldtype": "Data"
      },
      {
        "fieldname": "open_ai_model",
        "label": "Rédaction des textes du site, SEO et classement",
        "fieldtype": "Data",
        "default": "gpt-6.2-sol",
        "description": "Le modèle principal. gpt-6.2-sol : 2 $ / 10 $ par million de jetons (avant : gpt-5.2, 1,75 $ / 14 $)."
      },
      {
        "fieldname": "open_ai_temperature",
        "label": "OpenAI Temperature",
        "fieldtype": "Float",
        "default": "0.2",
        "description": "0 = deterministic, higher = more random"
      },
      {
        "fieldname": "gemini_section",
        "label": "Gemini",
        "fieldtype": "Section Break"
      },
      {
        "fieldname": "gemini_api_key",
        "label": "Gemini API Key",
        "fieldtype": "Data"
      },
      {
        "fieldname": "gemini_model",
        "label": "Retouche des images (Gemini)",
        "fieldtype": "Data",
        "default": "gemini-2.5-flash-image-preview",
        "description": "Modèle d’image de Google. gemini-3-pro-image-preview : environ 0,13 $ par image retouchée."
      },
      {
        "fieldname": "modeles_section",
        "label": "Un modèle par étape (OpenAI)",
        "fieldtype": "Section Break"
      },
      {
        "fieldname": "web_search_model",
        "label": "Recherche des caractéristiques sur internet",
        "fieldtype": "Data",
        "default": "gpt-6-luna",
        "description": "gpt-6-luna : 0,10 $ / 0,50 $ (avant : gpt-4.1-mini, 0,40 $ / 1,60 $). Chaque recherche coûte en plus 0,01 $."
      },
      {
        "fieldname": "keywords_model",
        "label": "Choix des mots-clés",
        "fieldtype": "Data",
        "default": "gpt-6-luna",
        "description": "gpt-6-luna : 0,10 $ / 0,50 $ (avant : gpt-5-mini, 0,25 $ / 2 $). Si les mots-clés déçoivent : gpt-6.1-terra (1 $ / 5 $)."
      },
      {
        "fieldname": "logistics_model",
        "label": "Poids et classe de livraison",
        "fieldtype": "Data",
        "default": "gpt-6-luna",
        "description": "gpt-6-luna : 0,10 $ / 0,50 $ (avant : gpt-5-mini, 0,25 $ / 2 $)."
      },
      {
        "fieldname": "alt_model",
        "label": "Texte alternatif des images",
        "fieldtype": "Data",
        "default": "gpt-6-luna",
        "description": "gpt-6-luna : 0,10 $ / 0,50 $ (avant : gpt-4o-mini, 0,15 $ / 0,60 $)."
      }
    ]
  }
]
